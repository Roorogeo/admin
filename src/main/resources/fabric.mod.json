{
	"schemaVersion": 1,
	"id": "discordcmd",
	"version": "${version}",
	"name": "Discord Command Bridge",
	"description": "Runs commands posted in a Discord channel on a Fabric server with full permissions. Channel access is the only gate.",
	"authors": [
		"roorogeo"
	],
	"contact": {
		"repo": "https://github.com/roorogeo/admin"
	},
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"server": [
			"com.roorogeo.discordcmd.DiscordCommandBridge"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": ">=26.2",
		"java": ">=21"
	}
}
